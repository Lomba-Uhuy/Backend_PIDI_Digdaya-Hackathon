{
  "name": "@tradeconnect/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript DTOs and event types across NestJS services",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dtos": "./src/dtos/index.ts",
    "./events": "./src/events/index.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "typescript": "5.7.2"
  }
}