# ───── Markdown: ignore all .md EXCEPT README.md (at any depth) ─────
# Keeps scratch/design notes out of the repo; README files are always kept.
*.md
!README.md

# ───── Node / TypeScript ─────
node_modules/
dist/
build/
*.tsbuildinfo
.turbo/
.next/
coverage/
.nyc_output/

# ───── Python ─────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.python-version
.uv-cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
coverage.xml

# ───── Environment ─────
.env
.env.*
!.env.example

# ───── Editors / OS ─────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# ───── Logs ─────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───── Docker / Local data ─────
.docker-data/

# ───── Build outputs / packaging ─────
*.tgz
*.tar.gz

# ───── Secrets / API keys (never commit) ─────
API-Document-Reference-Only/

# ───── Stray TS build artifacts in source dirs ─────
libs/**/src/**/*.js
libs/**/src/**/*.d.ts
libs/**/src/**/*.js.map

# ───── Agent / tool state ─────
.claude/
.claude/*
!.claude/settings.json
CLAUDE.md

# ───── Generated Python type stubs ─────
typings/

.run-logs/
.run-logs/*