{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@tradeconnect/shared-types": ["../../libs/shared-types/src"],
      "@tradeconnect/shared-types/*": ["../../libs/shared-types/src/*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}