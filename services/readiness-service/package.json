{
  "name": "@tradeconnect/readiness-service",
  "version": "0.1.0",
  "private": true,
  "description": "TradeConnect Readiness — FOB/CIF pricing, fraud detection, document checklist",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.0",
    "@nestjs/common": "11.0.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "11.0.6",
    "@nestjs/platform-fastify": "11.0.6",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/terminus": "11.0.0",
    "@tradeconnect/shared-types": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "decimal.js": "10.4.3",
    "nestjs-pino": "4.2.0",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.8",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}