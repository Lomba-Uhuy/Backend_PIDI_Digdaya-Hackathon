{
  "name": "@tradeconnect/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "TradeConnect API Gateway — auth, rate limiting, request proxying",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@bull-board/api": "7.1.5",
    "@bull-board/fastify": "7.1.5",
    "@bull-board/nestjs": "7.1.5",
    "@fastify/cookie": "11.0.1",
    "@fastify/helmet": "13.0.0",
    "@nestjs/axios": "3.1.3",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.0.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "11.0.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.0.6",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@tradeconnect/shared-types": "workspace:*",
    "axios": "1.7.9",
    "bullmq": "5.34.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "nestjs-pino": "4.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/node": "22.10.5",
    "@types/passport-jwt": "4.0.1",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "2.1.8",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}