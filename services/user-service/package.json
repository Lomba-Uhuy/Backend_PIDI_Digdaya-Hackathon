{
  "name": "@tradeconnect/user-service",
  "version": "0.1.0",
  "private": true,
  "description": "TradeConnect User Service — UMKM/Product CRUD, JWT issuance, BullMQ producer",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "clean": "rm -rf dist .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/helmet": "13.0.0",
    "@fastify/static": "9.1.3",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.0.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "11.0.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-fastify": "11.0.6",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/terminus": "11.0.0",
    "@tradeconnect/shared-types": "workspace:*",
    "bcrypt": "5.1.1",
    "bullmq": "5.34.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "drizzle-orm": "0.36.4",
    "nestjs-pino": "4.2.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.13.1",
    "pino-http": "10.3.0",
    "pino-pretty": "13.0.0",
    "postgres": "3.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "uuid": "11.0.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.6",
    "@types/bcrypt": "5.0.2",
    "@types/node": "22.10.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.11.10",
    "@types/uuid": "10.0.0",
    "@vitest/coverage-v8": "2.1.8",
    "drizzle-kit": "0.30.1",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}