# ============================================================
# TradeConnect Hybrid Microservice — Environment Template
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

# ───── Security ─────
# Generate: openssl rand -hex 64    (or in PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 })))
JWT_SECRET=CHANGE_ME_TO_64_CHAR_HEX_OR_LONGER
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=30m
JWT_REFRESH_TOKEN_EXPIRES=14d

# ───── Database (Postgres + pgvector) ─────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tc_user
POSTGRES_PASSWORD=tc_pass_dev
POSTGRES_DB=tradeconnect

# Used by Node services (Drizzle)
DATABASE_URL=postgres://tc_user:tc_pass_dev@localhost:5432/tradeconnect

# Used by Python services
DATABASE_URL_ASYNC=postgresql+asyncpg://tc_user:tc_pass_dev@localhost:5432/tradeconnect
DATABASE_URL_SYNC=postgresql+psycopg://tc_user:tc_pass_dev@localhost:5432/tradeconnect

# ───── Redis ─────
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
BULL_REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# ───── Service discovery (internal cluster URLs) ─────
USER_SERVICE_URL=http://user-service:3001
READINESS_SERVICE_URL=http://readiness-service:3002
MATCHING_SERVICE_URL=http://matching-service:8001
COMMS_SERVICE_URL=http://comms-service:8002

# ───── AI providers ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSIONS=1024

# ───── Indonesian government / global trade APIs ─────
# Token JWT dari sso.insw.go.id — login ke insw.go.id, copy dari browser DevTools (Network tab).
# Expires ~6 jam. Kosongkan jika tidak tersedia (INSW step akan dilewati).
INSW_TOKEN=
OSS_PUBLIC_NIB_URL=https://api-prd.oss.go.id/v1/reg/public/nib
# Public OSS NIB lookup currently requires browser-session style credentials.
# Fill from DevTools only in local/demo env; these values expire and must not be committed.
OSS_PUBLIC_USER_KEY=
OSS_PUBLIC_RECAPTCHA_RESPONSE=
OSS_PUBLIC_COOKIE=
INATRADE_BASE_URL=https://inatrade.kemendag.go.id
INATRADE_API_KEY=
UN_COMTRADE_API_KEY=
UN_COMTRADE_BASE_URL=https://comtradeapi.un.org/data/v1
UN_COMTRADE_TOOLS_BASE_URL=https://comtradeapi.un.org/tools/v1
UN_COMTRADE_PREVIEW_BASE_URL=https://comtradeapi.un.org/public/v1
BPS_API_BASE_URL=https://webapi.bps.go.id/v1
BPS_API_KEY=

# ───── Rate limiting ─────
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_AI_TTL=60
RATE_LIMIT_AI_LIMIT=20

# ───── Observability ─────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tradeconnect
LOG_LEVEL=info
SENTRY_DSN=

# ───── Feature flags ─────
FEATURE_SEMANTIC_MATCHING=true
FEATURE_RAG_NEGOTIATION=true
FEATURE_FRAUD_DETECTION=true
FEATURE_INATRADE_VERIFICATION=false

# ───── CORS ─────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
