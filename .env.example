# ============================================================
# TradeConnect Hybrid Microservice — Environment Template
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================

# ───── Security ─────
# Generate: openssl rand -hex 64    (or in PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Maximum 256 })))
JWT_SECRET=CHANGE_ME_TO_64_CHAR_HEX_OR_LONGER
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=30m
JWT_REFRESH_TOKEN_EXPIRES=14d

# ───── Database (Supabase Postgres + pgvector) ─────
# Use Supabase connection strings. Session pooler recommended for IPv4.
POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.YOUR_PROJECT_REF
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=postgres

# Used by Node services (Drizzle)
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Used by Python services
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL_SYNC=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ───── Redis ─────
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
BULL_REDIS_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5

# ───── Service discovery (internal cluster URLs) ─────
USER_SERVICE_URL=http://user-service:3001
READINESS_SERVICE_URL=http://readiness-service:3002
MATCHING_SERVICE_URL=http://matching-service:8001
COMMS_SERVICE_URL=http://comms-service:8002

# ───── AI providers ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.3
# Google Gemini — when GEMINI_API_KEY is set, comms-service uses it for negotiation
# drafting (falls through GEMINI_FALLBACK_MODELS when the primary is 503/429).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
LLM_MAX_TOKENS=2048
# Embedding provider: "gemini" (cloud, recommended) or "local" (sentence-transformers, heavy)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1024

# ───── Indonesian government / global trade APIs ─────
# Token JWT dari sso.insw.go.id — login ke insw.go.id, copy dari browser DevTools (Network tab).
# Expires ~6 jam. Kosongkan jika tidak tersedia (INSW step akan dilewati).
INSW_TOKEN=
OSS_PUBLIC_NIB_URL=https://api-prd.oss.go.id/v1/reg/public/nib
# Public OSS NIB lookup currently requires browser-session style credentials.
# Fill from DevTools only in local/demo env; these values expire and must not be committed.
OSS_PUBLIC_USER_KEY=
OSS_PUBLIC_RECAPTCHA_RESPONSE=
OSS_PUBLIC_COOKIE=
INATRADE_BASE_URL=https://inatrade.kemendag.go.id
INATRADE_API_KEY=
UN_COMTRADE_API_KEY=
UN_COMTRADE_BASE_URL=https://comtradeapi.un.org/data/v1
UN_COMTRADE_TOOLS_BASE_URL=https://comtradeapi.un.org/tools/v1
UN_COMTRADE_PREVIEW_BASE_URL=https://comtradeapi.un.org/public/v1
BPS_API_BASE_URL=https://webapi.bps.go.id/v1
BPS_API_KEY=

# ───── Buyer data source (TradeAtlas) ─────
# Real importer/buyer records for the matching engine. Auth is the login SESSION
# COOKIE (secret) — the full Cookie header value, e.g. "tradeatlas2_session=...".
# Leave blank to disable the sync (the task returns status=auth_required, no data faked).
BUYER_SOURCE_PROVIDER=tradeatlas
TRADEATLAS_BASE_URL=https://app.tradeatlas.com
TRADEATLAS_SEARCH_PATH=/api/search/unified
TRADEATLAS_SESSION_COOKIE=
TRADEATLAS_TIMEOUT_SECONDS=30
TRADEATLAS_MAX_RETRIES=4
TRADEATLAS_BACKOFF_BASE_SECONDS=1
TRADEATLAS_MAX_PAGES=40
BUYER_SYNC_BATCH_SIZE=100

# ───── Rate limiting ─────
RATE_LIMIT_DEFAULT_TTL=60
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_AI_TTL=60
RATE_LIMIT_AI_LIMIT=20

# ───── Observability ─────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tradeconnect
LOG_LEVEL=info
SENTRY_DSN=

# ───── Feature flags ─────
FEATURE_SEMANTIC_MATCHING=true
FEATURE_RAG_NEGOTIATION=true
FEATURE_FRAUD_DETECTION=true
FEATURE_INATRADE_VERIFICATION=false

# ───── CORS ─────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
